{
  "name": "prisma-review-website",
  "version": "1.2.0",
  "license": "MIT",
  "private": true,
  "description": "A PRISMA systematic review workflow website prototype.",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "start": "next start",
    "start:prod": "next start --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "check": "tsc --noEmit && npm run check:api-auth",
    "check:navigation": "node scripts/check-navigation.mjs",
    "check:progress": "node scripts/check-load-progress.mjs",
    "check:audit": "node scripts/check-audit-history.mjs",
    "check:workflow": "node scripts/check-workflow-reconciliation.mjs",
    "check:checkouts": "node scripts/check-review-checkout.mjs",
    "check:conflicts": "node scripts/check-conflict-queue.mjs && node scripts/check-blind-votes.mjs && node scripts/check-conflict-ui.mjs",
    "check:exports": "node scripts/check-export-consistency.mjs",
    "check:import-concurrency": "node scripts/check-import-concurrency.mjs",
    "check:retrieval": "node scripts/check-retrieval.mjs",
    "check:pdf-security": "node scripts/check-pdf-retrieval-security.mjs",
    "check:presence": "node scripts/check-presence.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:admin-users": "node scripts/check-admin-users.mjs",
    "check:email": "node scripts/check-transactional-email.mjs",
    "check:api-auth": "node scripts/check-api-route-auth.mjs",
    "backfill:pdfs:minio": "node scripts/backfill-pdfs-to-minio.mjs",
    "migrate:users:postgres": "node scripts/migrate-users-to-postgres.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "lucide-react": "1.16.0",
    "next": "^16.3.4",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  },  
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "8.15.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
